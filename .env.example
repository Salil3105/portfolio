# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real keys.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sender (onboarding@resend.dev),
# which works with no setup. Once you verify your own domain in Resend,
# set something like: Portfolio <hello@yourdomain.com>
CONTACT_FROM=
